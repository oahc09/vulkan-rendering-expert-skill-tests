#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=64) in;
layout(binding=0) uniform accelerationStructureEXT scene;
layout(binding=1,std430) buffer Results {vec4 result[];};
layout(push_constant) uniform Inputs {uint count;uint reflection;float scale;float light;}p;
bool alphaAccepted(rayQueryEXT q){
 uint primitive=rayQueryGetIntersectionPrimitiveIndexEXT(q,false);
 if(primitive/2u!=1u)return true;
 vec2 bary=rayQueryGetIntersectionBarycentricsEXT(q,false);
 // Triangle UVs (0,0),(1,0),(1,1) or (0,0),(1,1),(0,1).
 float u=(primitive%2u==0u)?bary.x+bary.y:bary.x;
 return fract(u*7.)<=.5;
}
void main(){uint i=gl_GlobalInvocationID.x;if(i>=p.count)return;
 vec3 origin=vec3((float(i%65u)+.5)/65.*1.3-.65,(float(i/65u)+.5)/49.*2.-1.,.8);
 origin.z=origin.y>.45?.65:.8;
 vec3 direction=p.reflection!=0u?normalize(vec3(.413,0,-1)):normalize(vec3(-p.light,0,-1));
 rayQueryEXT q;uint flags=p.reflection!=0u?0u:gl_RayFlagsTerminateOnFirstHitEXT;
 rayQueryInitializeEXT(q,scene,flags,255,origin,p.scale*.001,direction,p.scale*10.);
 while(rayQueryProceedEXT(q)){if(rayQueryGetIntersectionTypeEXT(q,false)==gl_RayQueryCandidateIntersectionTriangleEXT && alphaAccepted(q))rayQueryConfirmIntersectionEXT(q);}
 bool hit=rayQueryGetIntersectionTypeEXT(q,true)!=gl_RayQueryCommittedIntersectionNoneEXT;
 // Single closest-hit proxy radiance, NOT GI. Shadow branch is visibility.
 uint material=hit?rayQueryGetIntersectionPrimitiveIndexEXT(q,true)/2u:0u;
 vec3 colors[3]=vec3[](vec3(.3,.4,.5),vec3(.2,.6,.1),vec3(.7,.2,.1));
 result[i]=p.reflection!=0u?(hit?vec4(colors[material],1):vec4(.08,.12,.2,0)):vec4(hit?0.:1.);
}

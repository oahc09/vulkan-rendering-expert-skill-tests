#version 450
#extension GL_GOOGLE_include_directive : require
#include "sim.glsl"
layout(local_size_x=64) in;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=p.n)return;source[i]=state[i];
 uint x=i%p.width,y=i/p.width,l=y*p.width+(x==0?x:x-1),r=y*p.width+min(x+1,p.width-1),d=(y==0?y:y-1)*p.width+x,u=min(y+1,p.height-1)*p.width+x;
 vec3 n=vec3(0,0,1);
 if(p.mode==2){float dx=1./float(p.width-1),dy=1./float(p.height-1);n=normalize(vec3(-(state[r].x.x-state[l].x.x)/float(r-l)/dx,-(state[u].x.x-state[d].x.x)/float((u-d)/p.width)/dy,1));}
 else if(p.height>1){vec3 v=cross(state[r].x.xyz-state[l].x.xyz,state[u].x.xyz-state[d].x.xyz);if(length(v)>1e-8)n=normalize(v);}
 normal[i]=vec4(n,float(p.tick)); // same tick as published positions
}

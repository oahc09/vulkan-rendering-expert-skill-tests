#version 450
#extension GL_GOOGLE_include_directive : require
#include "sim.glsl"
layout(local_size_x=64) in;
void main(){ uint i=gl_GlobalInvocationID.x;if(i>=p.n)return;
 Particle q=source[i];q.previous=vec4(q.x.xyz,0);
 if(q.x.w>0)q.x.xyz+=source[i].x.xyz-source[i].previous.xyz+vec3(0,-.1,0)*p.viewX*p.viewX;
 state[i]=q;
}

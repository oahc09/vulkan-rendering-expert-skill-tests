#version 450
#extension GL_GOOGLE_include_directive : require
#include "sim.glsl"
layout(local_size_x=64) in;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=p.n)return;vec3 sum=vec3(0);
 for(uint e=0;e<p.capacity;e++){if(edges[e].a==i)sum+=delta[2*e].xyz;if(edges[e].b==i)sum+=delta[2*e+1].xyz;}
 state[i].x.xyz+=sum; // sum, relaxation 1: same algorithm as CPU, not GS-equivalent
}

#version 450
#extension GL_GOOGLE_include_directive : require
#include "sim.glsl"
layout(local_size_x=64) in;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=p.n)return;float impulse=0;
 for(uint e=0;e<p.capacity;e++)if(edges[e].a==i&&edges[e].b==p.tick)impulse+=edges[e].rest;
 source[i].x.y+=impulse; // unique cell writer; event IDs deduplicated by scheduler before upload
}

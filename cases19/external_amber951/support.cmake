cmake_minimum_required(VERSION 3.22)
project(amber951_support)
set(BASE "" CACHE PATH "Local dependency/engine artifact root")
if(NOT IS_DIRECTORY "${BASE}")
 message(FATAL_ERROR "Explicit BASE directory required")
endif()
set(glslang_SOURCE_DIR ${BASE}/cts-src/external/glslang/src)
set(SPIRV-Headers_SOURCE_DIR ${BASE}/cts-src/external/spirv-headers/src)
set(spirv-tools_SOURCE_DIR ${BASE}/cts-src/external/spirv-tools/src)
foreach(name glslang SPIRV SPIRV-Tools SPIRV-Tools-opt)
 add_library(${name} STATIC IMPORTED GLOBAL)
endforeach()
set_target_properties(glslang PROPERTIES IMPORTED_LOCATION ${BASE}/cts-build/external/glslang/src/glslang/libglslang.a INTERFACE_INCLUDE_DIRECTORIES ${glslang_SOURCE_DIR})
set_target_properties(SPIRV PROPERTIES IMPORTED_LOCATION ${BASE}/cts-build/external/glslang/src/SPIRV/libSPIRV.a)
set_target_properties(SPIRV-Tools PROPERTIES IMPORTED_LOCATION ${BASE}/cts-build/external/spirv-tools/spirv-tools/source/libSPIRV-Tools.a INTERFACE_INCLUDE_DIRECTORIES ${spirv-tools_SOURCE_DIR}/include)
set_target_properties(SPIRV-Tools-opt PROPERTIES IMPORTED_LOCATION ${BASE}/cts-build/external/spirv-tools/spirv-tools/source/opt/libSPIRV-Tools-opt.a INTERFACE_INCLUDE_DIRECTORIES ${spirv-tools_SOURCE_DIR}/include)
set(SHADERC_SKIP_TESTS ON CACHE BOOL "" FORCE)
set(SHADERC_SKIP_EXAMPLES ON CACHE BOOL "" FORCE)
set(SHADERC_SKIP_INSTALL ON CACHE BOOL "" FORCE)
set(SHADERC_ENABLE_WERROR_COMPILE OFF CACHE BOOL "" FORCE)
add_subdirectory(${BASE}/cts-build/_deps/shaderc-src shaderc)

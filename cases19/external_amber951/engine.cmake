# VARIANT=before|after; OFFICIAL_VULKAN_INCLUDE; VULKAN_LOADER_LIBRARY required.
# Separate build trees, CMAKE_CXX_FLAGS="-include cstdint"; no source fetch.
if(NOT VARIANT STREQUAL "before" AND NOT VARIANT STREQUAL "after")
 message(FATAL_ERROR "VARIANT must be before or after")
endif()
cmake_minimum_required(VERSION 3.22)
project(amber951_support)
set(BASE "" CACHE PATH "Local dependency/engine artifact root")
if(NOT IS_DIRECTORY "${BASE}")
 message(FATAL_ERROR "Explicit BASE directory required")
endif()
set(glslang_SOURCE_DIR ${BASE}/cts-src/external/glslang/src)
set(SPIRV-Headers_SOURCE_DIR ${BASE}/cts-src/external/spirv-headers/src)
set(spirv-tools_SOURCE_DIR ${BASE}/cts-src/external/spirv-tools/src)
foreach(name glslang SPIRV SPIRV-Tools SPIRV-Tools-opt)
 add_library(${name} STATIC IMPORTED GLOBAL)
endforeach()
set_target_properties(glslang PROPERTIES IMPORTED_LOCATION ${BASE}/cts-build/external/glslang/src/glslang/libglslang.a INTERFACE_INCLUDE_DIRECTORIES ${glslang_SOURCE_DIR})
set_target_properties(SPIRV PROPERTIES IMPORTED_LOCATION ${BASE}/cts-build/external/glslang/src/SPIRV/libSPIRV.a)
set_target_properties(SPIRV-Tools PROPERTIES IMPORTED_LOCATION ${BASE}/cts-build/external/spirv-tools/spirv-tools/source/libSPIRV-Tools.a INTERFACE_INCLUDE_DIRECTORIES ${spirv-tools_SOURCE_DIR}/include)
set_target_properties(SPIRV-Tools-opt PROPERTIES IMPORTED_LOCATION ${BASE}/cts-build/external/spirv-tools/spirv-tools/source/opt/libSPIRV-Tools-opt.a INTERFACE_INCLUDE_DIRECTORIES ${spirv-tools_SOURCE_DIR}/include)
add_library(shaderc STATIC IMPORTED GLOBAL)
add_library(shaderc_util STATIC IMPORTED GLOBAL)
set_target_properties(shaderc PROPERTIES IMPORTED_LOCATION ${BASE}/amber951-build-support/build/shaderc/libshaderc/libshaderc.a INTERFACE_INCLUDE_DIRECTORIES ${BASE}/cts-build/_deps/shaderc-src/libshaderc/include INTERFACE_LINK_LIBRARIES "shaderc_util;glslang;SPIRV;SPIRV-Tools-opt;SPIRV-Tools;pthread")
set_target_properties(shaderc_util PROPERTIES IMPORTED_LOCATION ${BASE}/amber951-build-support/build/shaderc/libshaderc_util/libshaderc_util.a INTERFACE_LINK_LIBRARIES "glslang;SPIRV;SPIRV-Tools-opt;SPIRV-Tools;pthread")
set(AMBER_SKIP_TESTS ON CACHE BOOL "" FORCE)
set(AMBER_SKIP_LODEPNG ON CACHE BOOL "" FORCE)
set(AMBER_DISABLE_WERROR ON CACHE BOOL "" FORCE)
set(AMBER_DISABLE_WEVERYTHING ON CACHE BOOL "" FORCE)
set(Vulkan_INCLUDE_DIR "${OFFICIAL_VULKAN_INCLUDE}" CACHE PATH "" FORCE)
set(Vulkan_LIBRARY "${VULKAN_LOADER_LIBRARY}" CACHE FILEPATH "" FORCE)
add_subdirectory(${BASE}/amber951-${VARIANT}-src amber)
# Modern static shader dependency cycles need an explicit linker rescan group.
target_link_libraries(amber -Wl,--start-group shaderc shaderc_util glslang SPIRV SPIRV-Tools-opt SPIRV-Tools -Wl,--end-group)

#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=1) in;
layout(set=0,binding=0) uniform accelerationStructureEXT scene;
layout(set=0,binding=1,std430) buffer Output { uint values[]; } outData;
layout(push_constant) uniform Rays { vec4 origins[2]; } rays;
void main(){
 uint i=gl_GlobalInvocationID.x;
 vec3 origin=rays.origins[i].xyz;
 rayQueryEXT q;
 rayQueryInitializeEXT(q,scene,gl_RayFlagsOpaqueEXT,255,origin,0.1,vec3(0,0,-1),10.0);
 while(rayQueryProceedEXT(q)){}
 uint kind=rayQueryGetIntersectionTypeEXT(q,true);
 outData.values[4*i]=kind;
 outData.values[4*i+1]=kind==gl_RayQueryCommittedIntersectionTriangleEXT?rayQueryGetIntersectionInstanceCustomIndexEXT(q,true):0xffffffffu;
 outData.values[4*i+3]=kind==gl_RayQueryCommittedIntersectionTriangleEXT?rayQueryGetIntersectionPrimitiveIndexEXT(q,true):0xffffffffu;
 outData.values[4*i+2]=kind==gl_RayQueryCommittedIntersectionTriangleEXT?floatBitsToUint(rayQueryGetIntersectionTEXT(q,true)):0;
}

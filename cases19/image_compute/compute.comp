#version 450
layout(local_size_x=1,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,r32ui) readonly uniform uimage2D sourceImage;
layout(set=0,binding=1,r32ui) writeonly uniform uimage2D resultImage;
void main(){ivec2 p=ivec2(gl_GlobalInvocationID.xy);uint x=imageLoad(sourceImage,p).r;imageStore(resultImage,p,uvec4(x*3u+7u,0,0,0));}

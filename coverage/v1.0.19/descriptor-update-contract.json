    {
      "api_owner": "VkWriteDescriptorSet",
      "condition_key": "core",
      "page": "chapters/descriptorsets.html",
      "text_html": "<code>descriptorType</code> <strong class=\"purple\">must</strong> match the type of <code>dstBinding</code> within <code>dstSet</code>",
      "vuid": "VUID-VkWriteDescriptorSet-descriptorType-00319"
